@echo off
title AXONOVA Launcher
color 0A

echo ========================================================
echo        AXONOVA: Brain MRI Analysis Platform
echo ========================================================
echo.
echo Starting FastAPI Backend (Port 8000)...
start "AXONOVA Backend" cmd /k "set PYTHONPATH=backend&& python -m uvicorn app.main:app --host 127.0.0.1 --port 8000"

echo Starting Vite Frontend (Port 5173)...
start "AXONOVA Frontend" cmd /k "cd frontend&& npm run dev -- --host 127.0.0.1 --port 5173"

echo.
echo Waiting 3 seconds for services to initialize...
timeout /t 3 /nobreak >nul

echo Opening browser at http://127.0.0.1:5173/tasks ...
start http://127.0.0.1:5173/tasks

echo.
echo ========================================================
echo  AXONOVA is up and running!
echo  - Conditions Hub: http://127.0.0.1:5173/tasks
echo  - Scan Center:    http://127.0.0.1:5173/scans
echo  - Backend API:    http://127.0.0.1:8000/docs
echo ========================================================
echo Keep the backend and frontend terminal windows open.
pause

